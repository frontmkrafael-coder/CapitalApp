{
  "name": "capitalyx-–-finance-ai",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "lint": "tsc --noEmit && eslint firestore.rules",
    "preview": "vite preview",
    "android:sync": "vite build && cap sync android",
    "android:apk": "npm run android:sync && ./android/gradlew -p android assembleDebug --no-daemon && cp android/app/build/outputs/apk/debug/app-debug.apk capitalyx-debug.apk"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.2",
    "@capacitor/app": "^8.1.2",
    "@capacitor/browser": "^8.0.5",
    "@capacitor/cli": "^8.6.2",
    "@capacitor/core": "^8.6.2",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/keyboard": "^8.0.6",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.4",
    "@firebase/eslint-plugin-security-rules": "^0.0.2",
    "@google/genai": "^3.6.1",
    "@tailwindcss/vite": "^4.3.5",
    "dotenv": "^17.4.2",
    "eslint": "^10.15.0",
    "express": "^5.2.1",
    "firebase": "^12.19.0",
    "firebase-admin": "^14.4.0",
    "framer-motion": "^12.24.10",
    "lucide-react": "^0.562.0",
    "multer": "^2.4.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "recharts": "^3.6.0",
    "tailwindcss": "^4.3.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.14.0",
    "@vitejs/plugin-react": "^5.0.0",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.13",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  }
}
